[
  {
    "id": "H-TABLE-SPAN",
    "title": "Table with spanning cells",
    "html": "<main><table><caption>Plan</caption><tr><th scope=\"col\">Tier</th><th scope=\"col\">Cost</th></tr><tr><td>Basic</td><td>$10</td></tr></table></main>",
    "invariant": "Preserve caption and cells.",
    "expectedTokens": [
      "Plan",
      "Tier",
      "Basic",
      "$10"
    ],
    "notes": "Provisional holdout."
  },
  {
    "id": "H-TABLE-ROW",
