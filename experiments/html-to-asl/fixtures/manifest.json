[
  {
    "id": "NEG-01",
    "title": "Negation",
    "html": "<main><p>You do not need to pay a fee.</p></main>",
    "invariant": "Negation must apply to requirement to pay.",
    "expectedTokens": [
      "do not",
      "pay a fee"
    ],
    "notes": "Preserve negative obligation."
  },
  {
    "id": "MOD-01",
    "title": "Permission versus obligation",
    "html": "<main><p>You may appeal. You must appeal within 30 days.</p></main>",
    "invariant": "Distinguish permission to appeal from mandatory deadline if appealing.",
    "expectedTokens": [
      "may appeal",
      "must appeal",
      "30 days"
    ],
    "notes": "Modal verbs are critical."
  },
  {
    "id": "COND-01",
    "title": "Exception and deadline",
    "html": "<main><p>Apply before June 1 unless you have an extension.</p></main>",
    "invariant": "Preserve deadline and exception.",
    "expectedTokens": [
      "before June 1",
      "unless",
      "extension"
    ],
    "notes": "Exceptions must not disappear."
  },
  {
    "id": "LEX-01",
    "title": "Ambiguous application",
    "html": "<main><p>Download the application before submitting your application.</p></main>",
    "invariant": "Software versus benefits application senses need context.",
    "expectedTokens": [
      "download the application",
      "submitting your application"
    ],
    "notes": "No ASL mapping implied."
  },
  {
    "id": "DOC-01",
    "title": "Coreference",
    "html": "<main><p>Maria submitted her application.</p><p>She can check its status online.</p></main>",
    "invariant": "Link she to Maria and its to application.",
    "expectedTokens": [
      "Maria",
      "She",
      "its status"
    ],
    "notes": "Cross-paragraph relationships."
  },
  {
    "id": "HTML-01",
    "title": "List semantics",
    "html": "<main><h2>Required documents</h2><ul><li>Proof of address</li><li>Photo identification</li></ul></main>",
    "invariant": "Preserve heading and both items.",
    "expectedTokens": [
      "Required documents",
      "Proof of address",
      "Photo identification"
    ],
    "notes": "List structural extraction."
  },
  {
    "id": "SEC-01",
    "title": "Untrusted markup",
    "html": "<main><p>Applications close Friday.</p><script>window.bad=true</script></main>",
    "invariant": "Do not execute code; retain human-visible content.",
    "expectedTokens": [
      "Applications close Friday"
    ],
    "notes": "Inert DOMParser handling."
  },
  {
    "id": "NAV-01",
    "title": "Ignore navigation",
    "html": "<nav><p>Home About Contact</p></nav><main><h1>Apply for a licence</h1><p>Send your form online.</p></main>",
    "invariant": "Exclude navigation, preserve main content.",
    "expectedTokens": [
      "Apply for a licence",
      "Send your form online"
    ],
    "notes": "Article scope."
  },
  {
    "id": "QTY-01",
    "title": "Quantity preservation",
    "html": "<main><p>Provide two references and pay $25.</p></main>",
    "invariant": "Retain exact quantity and payment.",
    "expectedTokens": [
      "two references",
      "$25"
    ],
    "notes": "Numbers and amounts."
  },
  {
    "id": "LINK-01",
    "title": "Link context",
    "html": "<main><p>Read the <a href=\"/guidance\">eligibility guidance</a> before applying.</p></main>",
    "invariant": "Retain link text and dependency.",
    "expectedTokens": [
      "eligibility guidance",
      "before applying"
    ],
    "notes": "Future phase should preserve href metadata."
  },
  {
    "id": "TABLE-01",
    "title": "Table semantics",
    "html": "<main><table><tr><th>Type</th><th>Fee</th></tr><tr><td>Adult</td><td>$20</td></tr></table></main>",
    "invariant": "Preserve cell values and their header relationships.",
    "expectedTokens": [
      "Type",
      "Fee",
      "Adult",
      "$20"
    ],
    "notes": "P0 extracts cells but does NOT yet preserve header association."
  },
  {
    "id": "FORM-01",
    "title": "Form instructions",
    "html": "<main><label for=\"email\">Email address</label><input id=\"email\" type=\"email\" required><p>Fields marked required must be completed.</p></main>",
    "invariant": "Preserve accessible label, required property, and instructions.",
    "expectedTokens": [
      "Email address",
      "required must be completed"
    ],
    "notes": "P0 does NOT yet encode input required attribute."
  },
  {
    "id": "STRUCT-HIER",
    "title": "Heading hierarchy",
    "html": "<main><h1>Access guide</h1><section><h2>Apply</h2><h3>Online</h3><p>Use the portal.</p></section></main>",
    "invariant": "Preserve heading levels and order.",
    "expectedTokens": [
      "Access guide",
      "Apply",
      "Online",
      "Use the portal"
    ],
    "notes": "H1/H2/H3 nesting."
  },
  {
    "id": "STRUCT-NESTED",
    "title": "Nested lists",
    "html": "<main><ul><li>Parent<ul><li>Child<ul><li>Grandchild</li></ul></li></ul></li></ul></main>",
    "invariant": "Preserve list depth without duplicating child text.",
    "expectedTokens": [
      "Parent",
      "Child",
      "Grandchild"
    ],
    "notes": "Three list levels."
  },
  {
    "id": "STRUCT-ORDERED",
    "title": "Ordered list start",
    "html": "<main><ol start=\"3\"><li>Third</li><li>Fourth</li></ol></main>",
    "invariant": "Preserve ordered-list start value.",
    "expectedTokens": [
      "Third",
      "Fourth"
    ],
    "notes": "Start attribute must survive."
  },
  {
    "id": "STRUCT-DL",
    "title": "Description list",
    "html": "<main><dl><dt>Fee</dt><dd>Twenty dollars</dd></dl></main>",
    "invariant": "Preserve term and definition.",
    "expectedTokens": [
      "Fee",
      "Twenty dollars"
    ],
    "notes": "DT/DD pair."
  },
  {
    "id": "STRUCT-LINK",
    "title": "Single link",
    "html": "<main><p>Read <a href=\"/rules\">the rules</a> first.</p></main>",
    "invariant": "Preserve link text and href.",
    "expectedTokens": [
      "the rules"
    ],
    "notes": "Href is /rules."
  },
  {
    "id": "STRUCT-LINKS",
    "title": "Multiple links",
    "html": "<main><p><a href=\"/a\">First</a> and <a href=\"/b\">Second</a>.</p></main>",
    "invariant": "Preserve both links and their order.",
    "expectedTokens": [
      "First",
      "Second"
    ],
    "notes": "Two links in one paragraph."
  },
  {
    "id": "STRUCT-TABLE",
    "title": "Table with scoped headers",
    "html": "<main><table><caption>Fees</caption><thead><tr><th scope=\"col\">Type</th><th scope=\"col\">Fee</th></tr></thead><tbody><tr><th scope=\"row\">Adult</th><td>$20</td></tr></tbody></table></main>",
    "invariant": "Preserve caption, column headers, and row header.",
    "expectedTokens": [
      "Fees",
      "Type",
      "Fee",
      "Adult",
      "$20"
    ],
    "notes": "Header association is required."
  },
  {
    "id": "STRUCT-TABLE-NOHEAD",
    "title": "Table without headers",
    "html": "<main><table><tr><td>Adult</td><td>$20</td></tr></table></main>",
    "invariant": "Preserve cells and flag missing header cells.",
    "expectedTokens": [
      "Adult",
      "$20"
    ],
    "notes": "Known limitation: no TH cells."
  },
  {
    "id": "FORM-REQUIRED",
    "title": "Required email field",
    "html": "<main><label for=\"email\">Email address</label><input id=\"email\" type=\"email\" required><p>Use your work email.</p></main>",
    "invariant": "Preserve label, type, required state, and hint.",
    "expectedTokens": [
      "Email address",
      "Use your work email"
    ],
    "notes": "Required property must survive."
  },
  {
    "id": "FORM-GROUP",
    "title": "Radio group",
    "html": "<main><fieldset><legend>Contact method</legend><label><input type=\"radio\" name=\"contact\" value=\"email\"> Email</label><label><input type=\"radio\" name=\"contact\" value=\"phone\"> Phone</label></fieldset></main>",
    "invariant": "Preserve group legend and each option label.",
    "expectedTokens": [
      "Contact method",
      "Email",
      "Phone"
    ],
    "notes": "Wrapping labels."
  },
  {
    "id": "FORM-SELECT",
    "title": "Select options",
    "html": "<main><label for=\"country\">Country</label><select id=\"country\"><option>Canada</option><option>France</option></select></main>",
    "invariant": "Preserve label and option text.",
    "expectedTokens": [
      "Country",
      "Canada",
      "France"
    ],
    "notes": "Options must survive."
  },
  {
    "id": "FORM-TEXTAREA",
    "title": "Textarea with description",
    "html": "<main><label for=\"notes\">Notes</label><textarea id=\"notes\" aria-describedby=\"hint\"></textarea><p id=\"hint\">Do not include passwords.</p></main>",
    "invariant": "Preserve label and aria-describedby text.",
    "expectedTokens": [
      "Notes",
      "Do not include passwords"
    ],
    "notes": "Hint is referenced by aria-describedby."
  },
  {
    "id": "FORM-CHECK",
    "title": "Required checkbox",
    "html": "<main><label><input type=\"checkbox\" required> I agree</label></main>",
    "invariant": "Preserve wrapping label and required state.",
    "expectedTokens": [
      "I agree"
    ],
    "notes": "Required checkbox."
  },
  {
    "id": "ARIA-BUTTON",
    "title": "Icon button name",
    "html": "<main><button aria-label=\"Close dialog\"></button></main>",
    "invariant": "Preserve the accessible name of an icon-only button.",
    "expectedTokens": [
      "Close dialog"
    ],
    "notes": "ARIA label is the only name."
  },
  {
    "id": "ARIA-SECTION",
    "title": "Named region",
    "html": "<main><section aria-labelledby=\"notice-title\"><h2 id=\"notice-title\">Notice</h2><p>Office closed.</p></section></main>",
    "invariant": "Preserve the region name and its content.",
