  {
    "id": "BARE-DIV",
    "title": "Bare container text",
    "html": "<main><div>Office closes at noon.</div></main>",
    "invariant": "Do not drop text in a bare container.",
    "expectedTokens": [
      "Office closes at noon"
    ],
    "notes": "P0 dropped this."
  },
  {
    "id": "HIDDEN",
    "title": "Hidden content",
    "html": "<main><p>Visible notice.</p><p hidden>Hidden notice.</p><p aria-hidden=\"true\">Aria hidden notice.</p><script>window.bad=true</script></main>",
    "invariant": "Exclude hidden content and scripts.",
    "expectedTokens": [
      "Visible notice"
    ],
    "notes": "Hidden and aria-hidden text must be absent."
  },
  {
    "id": "DETAILS-CLOSED",
    "title": "Closed details",
    "html": "<main><details><summary>More information</summary><p>Closed detail.</p></details></main>",
    "invariant": "Preserve summary and flag skipped closed content.",
    "expectedTokens": [
      "More information"
    ],
    "notes": "Closed content is not extracted."
  },
  {
    "id": "DETAILS-OPEN",
    "title": "Open details",
    "html": "<main><details open><summary>More information</summary><p>Open detail.</p></details></main>",
    "invariant": "Preserve summary and open content.",
    "expectedTokens": [
      "More information",
      "Open detail"
    ],
    "notes": "Open content is extracted."
  },
  {
    "id": "UNICODE",
    "title": "Unicode text",
    "html": "<main><p lang=\"fr\">Résumé — 日本語 — العربية</p></main>",
